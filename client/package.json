{
  "name": "@spellcaster/client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test:audio": "npm run build --workspace @spellcaster/shared && node --experimental-strip-types --test tests/audio/*.test.ts",
    "test:audio:browser": "playwright test --config playwright.audio.config.ts",
    "test:audio:combat": "npm run build --workspace @spellcaster/shared && npm run build --workspace @spellcaster/server && playwright test --config playwright.combat.config.ts",
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@spellcaster/shared": "0.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "phaser": "^3.88.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.5",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "vite": "^6.1.0"
  }
}
